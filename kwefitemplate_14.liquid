  if(qtyTextEl)   qtyTextEl.textContent   = infoQtyText(selectedPlan);

  // Sync hidden variant inputs so both CTA forms POST the right variant on submit
  var inputs = document.querySelectorAll('[data-kw-variant-input]');
  for(var vi=0; vi<inputs.length; vi++){ inputs[vi].value = p.variantId; }
}

// Guard: don't re-render if the same plan is clicked
for(var i=0;i<cards.length;i++){
