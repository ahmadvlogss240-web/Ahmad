}

render();


/* =========================================================
   KWEFI PREMIUM CART BRIDGE
   - Intercepts .kw-cta-form submits (capture phase)
   - Adds to Shopify via /cart/add.js
   - Renders premium drawer from /cart.js
   - Handles qty +/-, remove, recommendations
   - Backend/Shopify bundle logic untouched
   ========================================================= */
(function(){
  var FREE_SHIP_THRESHOLD_CENTS = 10000; // €100 — adjust as needed
  // Variant IDs that ALWAYS qualify for free shipping (bypass the threshold).
  // When any of these is in the cart, the progress bar is hidden and shipping
  // is shown as FREE regardless of subtotal. NOTE: the merchant must also
  // configure a matching free-shipping rule in Shopify Admin → Settings →
  // Shipping and delivery, otherwise the customer will still be charged at
  // checkout. This constant only controls the DISPLAY in the drawer.
  var FREE_SHIP_VARIANTS = {
    '58377214591240': true, // Buy 2 Get 1 FREE — Apple Find My + Charger
    '58377219145992': true  // Buy 2 Get 1 FREE — Apple & Android + Charger
  };
  var VARIANTS = window.KW_VARIANT_DISPLAY || {};

  function cartQualifiesForFreeShip(cart){
    if(!cart || !cart.items) return false;
    for(var i=0;i<cart.items.length;i++){
      var vid = String(cart.items[i].variant_id || cart.items[i].id || '');
      if(FREE_SHIP_VARIANTS[vid]) return true;
    }
    return false;
  }

  var drawer   = document.getElementById('kwDrawer');
  if(!drawer) return;
  var body     = document.body;
  var itemsEl  = document.getElementById('kwdItems');
  var emptyEl  = document.getElementById('kwdEmpty');
  var bodyEl   = document.getElementById('kwdBody');
  var footerEl = document.getElementById('kwdFooter');
  var subtotalEl  = document.getElementById('kwdSubtotal');
  var savingsRow  = document.getElementById('kwdSavingsRow');
  var savingsEl   = document.getElementById('kwdSavings');
  var shippingEl  = document.getElementById('kwdShipping');
  var totalEl     = document.getElementById('kwdTotal');
  var subtitleEl  = document.getElementById('kwdSubtitle');
  var progressEl  = document.getElementById('kwdProgress');
  var progressMsg = document.getElementById('kwdProgressMsg');
  var progressFill= document.getElementById('kwdProgressFill');
  var checkoutBtn = document.getElementById('kwdCheckout');
  var upsellSection = document.getElementById('kwdUpsell');
  var upsellList    = document.getElementById('kwdUpsellList');

  /* Formatting */
  function money(cents, currency){
    var symbol = { EUR:'€', USD:'$', GBP:'£', CHF:'CHF ' }[currency] || '€';
    var n = (cents || 0) / 100;
    return symbol + n.toFixed(2).replace('.', ',');
  }
  function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

  /* Open / close */
  function openDrawer(){
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden','false');
    body.classList.add('kwd-lock');
  }
  function closeDrawer(){
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden','true');
    body.classList.remove('kwd-lock');
  }
  drawer.addEventListener('click', function(e){ if(e.target.closest('[data-kwd-close]')) closeDrawer(); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape' && drawer.classList.contains('is-open')) closeDrawer(); });

  /* Cart API */
  function fetchCart(){ return fetch('/cart.js',{credentials:'same-origin'}).then(function(r){return r.json();}); }
  function changeQty(key, qty){
    return fetch('/cart/change.js',{
      method:'POST', credentials:'same-origin',
      headers:{'Content-Type':'application/json','Accept':'application/json','X-Requested-With':'XMLHttpRequest'},
      body: JSON.stringify({ id:key, quantity:qty })
    }).then(function(r){return r.json();});
  }

  /* Recommendations */
  var upsellCache = {};
  function loadUpsell(productId){
    if(!productId){ upsellSection.hidden = true; return; }
    if(upsellCache[productId]){ renderUpsell(upsellCache[productId]); return; }
    fetch('/recommendations/products.json?product_id=' + encodeURIComponent(productId) + '&limit=3&intent=complementary',{credentials:'same-origin'})
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(data){
        if(!data || !data.products || !data.products.length){ upsellSection.hidden = true; return; }
        upsellCache[productId] = data.products;
        renderUpsell(data.products);
      })
      .catch(function(){ upsellSection.hidden = true; });
  }
  function renderUpsell(products){
    if(!products.length){ upsellSection.hidden = true; return; }
    var html = '';
    for(var i=0;i<products.length;i++){
      var p = products[i];
      var v = p.variants && p.variants[0];
      if(!v) continue;
      var img = (p.featured_image && (p.featured_image.url || p.featured_image)) || (p.images && p.images[0]) || '';
      html += '<div class="kwd-upsell-item">'
        + '<div class="kwd-upsell-img">' + (img ? '<img src="' + esc(img) + '" alt="' + esc(p.title) + '" loading="lazy">' : '') + '</div>'
        + '<div class="kwd-upsell-info">'
        +   '<p class="kwd-upsell-name">' + esc(p.title) + '</p>'
        +   '<div class="kwd-upsell-price">' + money(v.price, 'EUR') + '</div>'
        + '</div>'
        + '<button type="button" class="kwd-upsell-add" data-kwd-upsell-add="' + esc(v.id) + '">'
        +   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>'
        +   'Add'
        + '</button>'
        + '</div>';
    }
    upsellList.innerHTML = html;
    upsellSection.hidden = false;
  }

  /* Render drawer from cart data */
  function renderDrawer(cart){
    if(!cart) return;
    var currency = cart.currency || 'EUR';
    var items = cart.items || [];

    // Subtitle count
    subtitleEl.textContent = cart.item_count + ' ' + (cart.item_count === 1 ? 'item' : 'items');

    // Empty state
    if(!items.length){
      itemsEl.innerHTML = '';
      bodyEl.hidden = true;
      footerEl.hidden = true;
      emptyEl.hidden = false;
      upsellSection.hidden = true;
      if(progressEl) progressEl.hidden = false;
      updateProgress(0);
      return;
    }
    bodyEl.hidden = false;
    footerEl.hidden = false;
    emptyEl.hidden = true;

    // Items
    var html = '';
    for(var i=0;i<items.length;i++){
      var it = items[i];
      var vid = String(it.variant_id || it.id || '');
      var custom = VARIANTS[vid] || {};
      var title = custom.title || it.product_title || it.title;
      var subtitle = custom.subtitle || (it.variant_title && it.variant_title !== 'Default Title' ? it.variant_title : '');
      var img = custom.image || it.image || (it.featured_image && it.featured_image.url) || '';
      var linePrice = it.final_line_price || it.line_price;
      var originalPrice = it.original_line_price || linePrice;
      var hasDiscount = originalPrice > linePrice;

      html += '<li class="kwd-item" data-key="' + esc(it.key) + '">'
        + '<div class="kwd-item-img">' + (img ? '<img src="' + esc(img) + '" alt="' + esc(title) + '" loading="lazy">' : '') + '</div>'
        + '<div class="kwd-item-info">'
        +   '<p class="kwd-item-title">' + esc(title) + '</p>'
        +   (subtitle ? '<span class="kwd-item-sub">' + esc(subtitle) + '</span>' : '')
        +   '<div class="kwd-item-qty">'
        +     '<button type="button" class="kwd-qty-btn" data-kwd-qty="dec" aria-label="Decrease">&minus;</button>'
        +     '<span class="kwd-qty-val">' + it.quantity + '</span>'
        +     '<button type="button" class="kwd-qty-btn" data-kwd-qty="inc" aria-label="Increase">+</button>'
        +   '</div>'
        + '</div>'
        + '<div class="kwd-item-right">'
        +   '<button type="button" class="kwd-item-remove" data-kwd-remove aria-label="Remove item">'
        +     '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>'
        +   '</button>'
        +   '<div class="kwd-item-price-block">'
        +     '<span class="kwd-item-price">' + money(linePrice, currency) + '</span>'
        +     (hasDiscount ? '<span class="kwd-item-price-strike">' + money(originalPrice, currency) + '</span>' : '')
        +   '</div>'
        + '</div>'
        + '</li>';
    }
    itemsEl.innerHTML = html;

    // Summary
    subtotalEl.textContent = money(cart.items_subtotal_price || cart.total_price, currency);
    var savings = (cart.original_total_price || cart.items_subtotal_price || 0) - (cart.total_price || 0);
    if(savings > 0){
      savingsEl.textContent = '−' + money(savings, currency);
      savingsRow.hidden = false;
    } else {
      savingsRow.hidden = true;
    }
    totalEl.textContent = money(cart.total_price, currency);

    // Free shipping — either a qualifying bundle in cart, or threshold met
    var freeByProduct = cartQualifiesForFreeShip(cart);
    var freeShip = freeByProduct || (cart.total_price >= FREE_SHIP_THRESHOLD_CENTS);
    if(freeShip){
      shippingEl.textContent = 'FREE';
      shippingEl.classList.add('is-free');
    } else {
      shippingEl.textContent = 'Calculated at checkout';
      shippingEl.classList.remove('is-free');
    }

    // Progress bar — hidden entirely when a qualifying bundle is in the cart
    if(freeByProduct){
      if(progressEl) progressEl.hidden = true;
    } else {
      if(progressEl) progressEl.hidden = false;
      updateProgress(cart.total_price);
    }

    // Recommendations (based on first cart item)
    loadUpsell(items[0].product_id);
  }

  function updateProgress(totalCents){
    if(!progressFill || !progressMsg) return;
    var pct = Math.min(100, Math.round((totalCents / FREE_SHIP_THRESHOLD_CENTS) * 100));
    progressFill.style.width = pct + '%';
    if(totalCents >= FREE_SHIP_THRESHOLD_CENTS){
      progressMsg.innerHTML = '🎉 You qualify for FREE Shipping!';
      progressMsg.classList.add('is-met');
      progressFill.classList.add('is-met');
    } else {
      var remaining = FREE_SHIP_THRESHOLD_CENTS - totalCents;
      progressMsg.textContent = 'Add ' + money(remaining, 'EUR') + ' more for FREE Shipping';
      progressMsg.classList.remove('is-met');
      progressFill.classList.remove('is-met');
    }
  }

  /* Item actions (qty +/-, remove) */
  itemsEl.addEventListener('click', function(e){
    var qBtn = e.target.closest('[data-kwd-qty]');
    var rBtn = e.target.closest('[data-kwd-remove]');
    var row = e.target.closest('.kwd-item');
    if(!row) return;
    var key = row.getAttribute('data-key');
    if(!key || drawer.classList.contains('is-adding')) return;

    if(rBtn){
      drawer.classList.add('is-adding');
      changeQty(key, 0)
        .then(function(cart){ renderDrawer(cart); })
        .catch(function(err){ console.error('[kwefi] remove failed', err); })
        .then(function(){ drawer.classList.remove('is-adding'); });
      return;
    }
    if(qBtn){
      var dir = qBtn.getAttribute('data-kwd-qty');
      var current = parseInt(row.querySelector('.kwd-qty-val').textContent, 10) || 1;
      var next = dir === 'inc' ? current + 1 : Math.max(0, current - 1);
      drawer.classList.add('is-adding');
      changeQty(key, next)
        .then(function(cart){ renderDrawer(cart); })
        .catch(function(err){ console.error('[kwefi] qty change failed', err); })
        .then(function(){ drawer.classList.remove('is-adding'); });
    }
  });

  /* Upsell add */
  upsellList.addEventListener('click', function(e){
    var btn = e.target.closest('[data-kwd-upsell-add]');
    if(!btn || btn.disabled) return;
    var vid = btn.getAttribute('data-kwd-upsell-add');
    btn.disabled = true; var oldHtml = btn.innerHTML; btn.textContent = 'Adding...';
    fetch('/cart/add.js',{
      method:'POST', credentials:'same-origin',
      headers:{'Content-Type':'application/json','Accept':'application/json','X-Requested-With':'XMLHttpRequest'},
      body: JSON.stringify({ items:[{ id:vid, quantity:1 }] })
    })
    .then(function(){ return fetchCart(); })
    .then(function(cart){ renderDrawer(cart); })
    .catch(function(err){ console.error('[kwefi] upsell add failed', err); })
    .then(function(){ btn.disabled = false; btn.innerHTML = oldHtml; });
  });

  /* Checkout */
  checkoutBtn.addEventListener('click', function(){ window.location.href = '/checkout'; });

  /* Intercept CTA form submits (capture phase to beat theme handlers) */
  function handleSubmit(e){
    e.preventDefault();
    e.stopImmediatePropagation();
    var form = e.currentTarget;
    if(form.dataset.kwBusy === '1') return;
    form.dataset.kwBusy = '1';

    var labelEl = form.querySelector('.kw-cta-label');
    var origLabel = labelEl ? labelEl.textContent : null;
    if(labelEl) labelEl.textContent = 'Adding...';

    var fd = new FormData(form);
    var ctrl = new AbortController();
    var timer = setTimeout(function(){ ctrl.abort(); }, 12000);

    fetch('/cart/add.js',{
      method:'POST', body: fd, credentials:'same-origin',
      headers:{'Accept':'application/javascript','X-Requested-With':'XMLHttpRequest'},
      signal: ctrl.signal
    })
    .then(function(r){ return r.json().then(function(j){ return {ok:r.ok,data:j}; }); })
    .then(function(res){
      clearTimeout(timer);
      if(!res.ok) throw new Error((res.data && res.data.description) || 'Add to cart failed');
      return fetchCart();
    })
    .then(function(cart){
      renderDrawer(cart);
      openDrawer();
    })
    .catch(function(err){
      console.error('[kwefi] add to cart failed', err);
      if(err && err.name !== 'AbortError') alert('Sorry, we could not add this item. Please try again.');
    })
    .then(function(){
      if(labelEl && origLabel != null) labelEl.textContent = origLabel;
      form.dataset.kwBusy = '';
    });
  }

  function bindForms(){
    var forms = document.querySelectorAll('.kw-cta-form');
    for(var i=0;i<forms.length;i++){
      if(forms[i].dataset.kwBound === '1') continue;
      forms[i].dataset.kwBound = '1';
      forms[i].addEventListener('submit', handleSubmit, { capture: true });
    }
  }

  function init(){
    bindForms();
    fetchCart().then(function(cart){
      // Only render items so the header count is accurate; drawer stays closed until user opens it
      renderDrawer(cart);
    }).catch(function(){});
  }
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();


/* Rotating announcement bar — INJECTS INTO THE THEME'S ANNOUNCEMENT SLOT
   Finds the theme's announcement bar (or the "Welcome to our store" element)
   and replaces its inner content with our rotating messages. This lets the
   bar sit at the very top of the store — exactly where the theme currently
   shows "Welcome to our store" — without touching theme files. */
(function(){
  var SLIDES = [
    { icon:'<rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
      html:'Secure Payment <em>·</em> <b>100% Safe Checkout</b>' },
    { icon:'<rect x="1" y="6" width="15" height="11" rx="1"/><path d="M16 10h4l3 3v4h-7"/><circle cx="6" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>',
      html:'<b>Free Shipping</b> on Bundle Offers' },
    { icon:'<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>',
      html:'<b>30-Day</b> Money-Back Guarantee' },
    { icon:'<rect x="6" y="2" width="12" height="20" rx="2"/><line x1="10" y1="18" x2="14" y2="18"/>',
      html:'Works with <b>Apple Find My &amp; Android Find Hub</b>' },
    { icon:'<polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>',
      html:'<b>Buy 2 Get 1 FREE</b> <em>·</em> Best Value' },
    { icon:'<path d="M12 2s-6 8-6 13a6 6 0 0 0 12 0c0-5-6-13-6-13z"/>',
      html:'Waterproof <em>·</em> <b>Ultra-Thin 2 mm</b> <em>·</em> Durable' },
    { icon:'<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>',
      html:'<b>PayPal &amp; Klarna</b> Available at Checkout' }
  ];
  var INTERVAL = 2500;

  function svgWrap(inner){
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + inner + '</svg>';
  }

  function buildMarkup(){
    var html = '<div class="kw-ann-track">';
    for(var i=0;i<SLIDES.length;i++){
      html += '<div class="kw-ann-slide' + (i===0?' is-active':'') + '">'
        + svgWrap(SLIDES[i].icon)
        + '<span>' + SLIDES[i].html + '</span>'
        + '</div>';
    }
    return html + '</div>';
  }

  function injectStyles(){
    if(document.getElementById('kwAnnStyles')) return;
    var css = ''
      + '.kw-ann-injected{background:#0a0f1a !important;color:#fff !important;font-family:"Inter","Helvetica Neue",sans-serif !important;overflow:hidden !important;padding:0 !important;margin:0 !important;min-height:0 !important;display:block !important}'
      + '.kw-ann-injected *{box-sizing:border-box}'
      + '.kw-ann-track{position:relative;height:44px;width:100%;max-width:100%}'
      + '.kw-ann-slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:10px;padding:0 24px;opacity:0;transform:translateY(6px);transition:opacity .55s ease,transform .55s ease;pointer-events:none;text-align:center;line-height:1}'
      + '.kw-ann-slide.is-active{opacity:1;transform:translateY(0);pointer-events:auto}'
      + '.kw-ann-slide svg{width:16px;height:16px;flex-shrink:0;color:#e2e8f0}'
      + '.kw-ann-slide span{font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:calc(100vw - 70px)}'
      + '.kw-ann-slide b{color:#10b981;font-weight:800;letter-spacing:.09em}'
      + '.kw-ann-slide em{font-style:normal;color:#475569;margin:0 3px}'
      + '@media (max-width:520px){'
      +   '.kw-ann-track{height:38px}'
      +   '.kw-ann-slide{padding:0 14px;gap:7px}'
      +   '.kw-ann-slide svg{width:13px;height:13px}'
      +   '.kw-ann-slide span{font-size:11px;letter-spacing:.06em}'
      + '}';
    var style = document.createElement('style');
    style.id = 'kwAnnStyles';
    style.textContent = css;
    document.head.appendChild(style);
  }

  function findAnnouncementTarget(){
    // 1) Try well-known Shopify theme selectors
    var selectors = [
      '.announcement-bar__message',
      '.announcement-bar',
      '.header__announcement',
      '.announcement__wrapper',
      '.utility-bar__message',
      '.utility-bar',
      '.header-announcement',
      '.top-bar-message',
      '#shopify-section-announcement-bar .announcement',
      '#shopify-section-announcement-bar'
    ];
    for(var i=0;i<selectors.length;i++){
      var el = document.querySelector(selectors[i]);
      if(el && el.offsetParent !== null) return el; // must be visible
    }
    // 2) Fallback: find any element whose text is exactly "Welcome to our store"
    //    (or common localized variants). Walk small nodes only to be safe.
    var candidates = document.querySelectorAll('body [class*="announce"], body [class*="Announce"], body [id*="announce"], body header *');
    var needle = /^(welcome to our store|welcome to the store)$/i;
    for(var j=0;j<candidates.length;j++){
      var c = candidates[j];
      if(c.children.length === 0){
        var t = (c.textContent || '').trim();
        if(t && needle.test(t)) return c.closest('.announcement-bar, .announcement, [class*="announce"]') || c.parentElement;
      }
    }
    return null;
  }

  function startRotation(root){
    var slides = root.querySelectorAll('.kw-ann-slide');
    if(slides.length < 2) return;
    var idx = 0;
    var timer = null;
    function show(next){
      slides[idx].classList.remove('is-active');
      idx = next % slides.length;
      slides[idx].classList.add('is-active');
    }
    function start(){ if(!timer) timer = setInterval(function(){ show(idx + 1); }, INTERVAL); }
    function stop(){ if(timer){ clearInterval(timer); timer = null; } }
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', function(){ if(document.hidden) stop(); else start(); });
    start();
  }

  function tryInject(){
    var target = findAnnouncementTarget();
    if(!target) return false;
    if(target.classList.contains('kw-ann-injected')) return true; // already done
    injectStyles();
    target.classList.add('kw-ann-injected');
    target.innerHTML = buildMarkup();
    startRotation(target);
    return true;
  }

  function init(){
    if(tryInject()) return;
    // Theme header may render slightly after DOMContentLoaded; retry briefly
    var attempts = 0;
    var iv = setInterval(function(){
      attempts++;
      if(tryInject() || attempts >= 20) clearInterval(iv); // ~4s window
    }, 200);
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();


/* Gallery — carousel track with real-time swipe */
(function(){
  var stageEl = document.querySelector('.kw-stage');
  var stageTag = document.getElementById('kwStageTag');
  var oldImg = document.getElementById('kwStage');
  var thumbs = [].slice.call(document.querySelectorAll('.kw-thumb'));
  if(!stageEl || !thumbs.length) return;

  // Build the carousel track from thumbs (all images preloaded)
  var track = document.createElement('div');
  track.className = 'kw-stage-track';
  thumbs.forEach(function(t){
    var slide = document.createElement('div');
    slide.className = 'kw-stage-slide';
    var img = document.createElement('img');
    img.src = t.dataset.img;
    img.alt = '';
    img.decoding = 'async';
    slide.appendChild(img);
    track.appendChild(slide);
  });
  if(oldImg) oldImg.remove();
  stageEl.appendChild(track);

  var currentIdx = 0;
  var trackW = stageEl.offsetWidth;

  function setTransform(x, animate){
    if(animate){ track.classList.remove('is-dragging'); }
    else { track.classList.add('is-dragging'); }
    track.style.transform = 'translate3d(' + x + 'px, 0, 0)';
  }

  function goTo(index, animate, userInitiated){
    if(index < 0) index = 0;
    if(index >= thumbs.length) index = thumbs.length - 1;
    currentIdx = index;
    trackW = stageEl.offsetWidth;
    setTransform(-index * trackW, animate !== false);
    thumbs.forEach(function(x){ x.classList.remove('is-active'); });
    var t = thumbs[index];
    if(t){
      t.classList.add('is-active');
      if(stageTag) stageTag.textContent = t.dataset.tag;
    }
  }

  thumbs.forEach(function(t, i){
    t.addEventListener('click', function(){ goTo(i, true, true); });
  });

  window.addEventListener('resize', function(){ goTo(currentIdx, false, false); });

  // Touch / pointer drag with real-time follow
  var startX = 0, startY = 0, dx = 0, lockAxis = null, isDown = false, baseOffset = 0;

  function onStart(x, y){
    isDown = true; lockAxis = null; dx = 0;
    startX = x; startY = y;
    trackW = stageEl.offsetWidth;
    baseOffset = -currentIdx * trackW;
    track.classList.add('is-dragging');
  }
  function onMove(x, y, ev){
    if(!isDown) return;
    var nx = x - startX, ny = y - startY;
    if(!lockAxis){
      if(Math.abs(nx) > 6 || Math.abs(ny) > 6){
        lockAxis = Math.abs(nx) > Math.abs(ny) ? 'x' : 'y';
      }
    }
    if(lockAxis === 'x'){
      if(ev && ev.cancelable) ev.preventDefault();
      dx = nx;
      var offset = baseOffset + dx;
      // Rubber-band at edges
      if((currentIdx === 0 && dx > 0) || (currentIdx === thumbs.length - 1 && dx < 0)){
        offset = baseOffset + dx * 0.35;
      }
      setTransform(offset, false);
    }
  }
  function onEnd(){
    if(!isDown) return;
    isDown = false;
    if(lockAxis !== 'x'){ lockAxis = null; return; }
    var absDx = Math.abs(dx);
    if(absDx > trackW * 0.12){
      goTo(currentIdx + (dx < 0 ? 1 : -1), true);
    } else {
      goTo(currentIdx, true);
    }
    dx = 0; lockAxis = null;
  }

  stageEl.addEventListener('touchstart', function(e){ var t = e.touches[0]; onStart(t.clientX, t.clientY); }, { passive:true });
  stageEl.addEventListener('touchmove',  function(e){ var t = e.touches[0]; onMove(t.clientX, t.clientY, e); }, { passive:false });
  stageEl.addEventListener('touchend',   onEnd, { passive:true });
  stageEl.addEventListener('touchcancel',function(){ isDown = false; lockAxis = null; }, { passive:true });
  stageEl.addEventListener('mousedown',  function(e){ e.preventDefault(); onStart(e.clientX, e.clientY); });
  window.addEventListener('mousemove',   function(e){ onMove(e.clientX, e.clientY, e); });
  window.addEventListener('mouseup',     onEnd);

  goTo(0, false);
})();

