/* Country flag from visitor IP */
(function(){
  var el = document.getElementById('kwFlag'); if(!el) return;
  function flagEmoji(cc){
    if(!cc || cc.length !== 2) return '';
    var A = 0x1F1E6, base = 'A'.charCodeAt(0);
    cc = cc.toUpperCase();
    return String.fromCodePoint(A + cc.charCodeAt(0) - base) +
           String.fromCodePoint(A + cc.charCodeAt(1) - base);
  }
  fetch('https://ipwho.is/?fields=country_code')
    .then(function(r){ return r.json(); })
    .then(function(d){ if(d && d.country_code) el.textContent = flagEmoji(d.country_code); })
    .catch(function(){});
})();

