});

/* Confetti */
var canvas = document.getElementById('kwConfetti');
var ctx = canvas.getContext('2d');
var pieces = [], running = false;
function sizeCanvas(){ canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
sizeCanvas(); window.addEventListener('resize', sizeCanvas);
function fireConfetti(){
  var colors = ['#9ca3af','#c0c0c0','#d1d5db','#6b7280','#a8a8a8','#111827'];
  var cx = canvas.width/2, cy = canvas.height/3;
  for(var i=0;i<140;i++){
    var a = Math.random()*Math.PI*2, sp = 6+Math.random()*8;
    pieces.push({ x:cx+(Math.random()-0.5)*200, y:cy, vx:Math.cos(a)*sp*(0.5+Math.random()), vy:Math.sin(a)*sp-4, g:0.18+Math.random()*0.08, sz:6+Math.random()*6, c:colors[Math.floor(Math.random()*colors.length)], rot:Math.random()*Math.PI, vr:(Math.random()-0.5)*0.3, life:1 });
  }
  if(!running){ running=true; animate(); }
}
function animate(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  pieces = pieces.filter(function(p){ return p.life>0 && p.y<canvas.height+40; });
  pieces.forEach(function(p){ p.vy+=p.g; p.x+=p.vx; p.y+=p.vy; p.rot+=p.vr; p.life-=0.005; ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot); ctx.fillStyle=p.c; ctx.globalAlpha=Math.max(0,p.life); ctx.fillRect(-p.sz/2,-p.sz/4,p.sz,p.sz/2); ctx.restore(); });
  if(pieces.length>0) requestAnimationFrame(animate); else running=false;
}
var SESSION_KEY='kwCelebrated', celebrated=false, toastTimer;
try { celebrated = sessionStorage.getItem(SESSION_KEY)==='1'; } catch(e){}
function celebrate(){
